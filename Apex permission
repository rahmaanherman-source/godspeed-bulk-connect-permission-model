    // =============================================================
    // 6. UTILITY FUNCTIONS
    // =============================================================
    function sha256(str) {
        const encoder = new TextEncoder();
        const data = encoder.encode(str);
        return crypto.subtle.digest('SHA-256', data).then(buf => {
            const bytes = new Uint8Array(buf);
            return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
        }).catch(() => {
            // Fallback (synchronous, less secure but works without async)
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                const char = str.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash = hash & hash;
            }
            return Math.abs(hash).toString(16).padStart(8, '0');
        });
    }

    // Synchronous fallback for immediate use
    function sha256Sync(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        return Math.abs(hash).toString(16).padStart(8, '0');
    }

    function storeCheckHistory(input, proof, timestamp) {
        const history = JSON.parse(localStorage.getItem('complianceHistory') || '[]');
        history.push({ input, proof, timestamp, results: 'stored' });
        if (history.length > 100) history.shift();
        localStorage.setItem('complianceHistory', JSON.stringify(history));
    }

    function clearResults() {
        document.getElementById('checkResults').classList.add('hidden');
        document.getElementById('resultContainer').innerHTML = '';
        document.getElementById('proofBox').innerHTML = '';
        showToast('Info', 'Results cleared.');
    }

    function exportRegistry() {
        if (registry.length === 0) {
            showToast('Info', 'Registry is empty.');
            return;
        }
        let csv = 'ID,Organization,Industry,Jurisdiction,Status,Registered,Proof\n';
        for (const org of registry) {
            csv += `${org.id},"${org.name}","${org.industry}","${org.jurisdiction}",${org.status},${org.registered},${org.proof}\n`;
        }
        const blob = new Blob([csv], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'compliance-registry.csv';
        a.click();
        URL.revokeObjectURL(url);
        showToast('Success', 'Registry exported as CSV.');
    }

    // =============================================================
    // 7. TAB SWITCHING
    // =============================================================
    function switchTab(tabId) {
        document.querySelectorAll('.nav-links a').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.nav-links a').forEach(el => {
            if (el.dataset.tab === tabId) el.classList.add('active');
        });

        document.querySelectorAll('section[id^="tab-"]').forEach(el => el.classList.add('hidden'));
        const target = document.getElementById('tab-' + tabId);
        if (target) target.classList.remove('hidden');

        // Render registry if switching to registry tab
        if (tabId === 'registry') renderRegistry();
        if (tabId === 'badge') loadBadge();
    }

    document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            switchTab(link.dataset.tab);
        });
    });

    // =============================================================
    // 8. TOAST NOTIFICATION
    // =============================================================
    function showToast(title, body) {
        const toast = document.getElementById('toast');
        document.getElementById('toastTitle').textContent = title;
        document.getElementById('toastBody').textContent = body;
        toast.classList.add('show');
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => toast.classList.remove('show'), 4000);
    }

    // =============================================================
    // 9. ENTER KEY SUPPORT
    // =============================================================
    document.getElementById('complianceInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') runComplianceCheck();
