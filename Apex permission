    actionHash: string; // Hash of the action
    combinedHash: string; // SHA-256(contentHash + actionHash + timestamp)
  };
}

interface ComplianceReport {
  actionId: string;
  timestamp: number;
  checks: ComplianceCheck[];
  overallStatus: 'COMPLIANT' | 'NON_COMPLIANT';
  violations: string[];
  proofHash: string; // SHA-256 of all checks + timestamps
}

// --- LAW DATABASE (DYNAMICALLY FETCHED) ---
class LawDatabase {
  private laws: Map<string, Law> = new Map();
  private fetchIntervalMs: number = 86400000; // 24 hours in ms

  constructor() {
    this.initialize();
  }

  // Initialize with hardcoded laws (fallback)
  private initialize(): void {
    const initialLaws: Law[] = [
      {
        id: 'GDPR_Art5',
        name: 'GDPR Article 5',
        jurisdiction: 'EU',
        section: 'Principles relating to processing of personal data',
        url: 'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32016R0679#d1e1604-1-1',
        lastUpdated: Date.now(),
        contentHash: '',
      },
      {
        id: 'CCPA_1798.100',
        name: 'CCPA §1798.100',
        jurisdiction: 'California, USA',
        section: 'Disclosure of personal information',
        url: 'https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.100',
        lastUpdated: Date.now(),
        contentHash: '',
      },
      {
        id: 'HIPAA_164.312',
        name: 'HIPAA §164.312',
        jurisdiction: 'USA',
        section: 'Security standards for protected health information',
        url: 'https://www.law.cornell.edu/cfr/text/45/164.312',
        lastUpdated: Date.now(),
        contentHash: '',
      },
      {
        id: 'NIST_SP800_207',
        name: 'NIST SP 800-207',
        jurisdiction: 'USA',
        section: 'Zero Trust Architecture',
        url: 'https://csrc.nist.gov/publications/detail/sp/800-207/final',
        lastUpdated: Date.now(),
        contentHash: '',
      },
    ];

    initialLaws.forEach(law => {
      this.laws.set(law.id, law);
    });

    // Start periodic updates
    this.startPeriodicUpdates();
  }

  // Fetch and update a law's content and hash
  private async fetchLaw(law: Law): Promise<Law> {
    try {
      const response = await axios.get(law.url);
      const content = response.data;
      const contentHash = createHash('sha256').update(content).digest('hex');
      return {
        ...law,
        lastUpdated: Date.now(),
        contentHash,
      };
    } catch (error) {
      console.error(`Failed to fetch law ${law.id}: ${error}`);
      return law; // Return unchanged if fetch fails
    }
  }

  // Update all laws periodically
  private async startPeriodicUpdates(): Promise<void> {
    for await (const _ of setInterval(this.fetchIntervalMs)) {
      const updatePromises = Array.from(this.laws.values()).map(law => this.fetchLaw(law));
      const updatedLaws = await Promise.all(updatePromises);
      updatedLaws.forEach(law => {
        this.laws.set(law.id, law);
      });
      console.log(`[${new Date().toISOString()}] Updated all laws.`);
    }
  }

  // Get a law by ID
  getLaw(lawId: string): Law | undefined {
    return this.laws.get(lawId);
  }

  // Get all laws
  getAllLaws(): Law[] {
    return Array.from(this.laws.values());
  }

  // Get laws by jurisdiction
  getLawsByJurisdiction(jurisdiction: string): Law[] {
    return Array.from(this.laws.values()).filter(law => law.jurisdiction === jurisdiction);
  }
}

// --- REAL-TIME COMPLIANCE CHECKER ---
class RealTimeComplianceChecker {
  private lawDb: LawDatabase;
  private actionQueue: Action[] = [];
  private complianceReports: Map<string, ComplianceReport> = new Map();

  constructor() {
    this.lawDb = new LawDatabase();
  }

  // Add an action to the queue for compliance checking
  addAction(action: Action): void {
    this.actionQueue.push(action);
  }

  // Check an action against all relevant laws
  private async checkActionAgainstLaws(action: Action): Promise<ComplianceReport> {
    const relevantLaws = this.getRelevantLaws(action);
    const checks: ComplianceCheck[] = [];
    const violations: string[] = [];

    for (const law of relevantLaws) {
      const check = await this.checkAgainstLaw(action, law);
      checks.push(check);
      if (!check.isCompliant) {
        violations.push(...check.violations);
      }
    }

    const overallStatus = violations.length === 0 ? 'COMPLIANT' : 'NON_COMPLIANT';
    const proofHash = this.generateProofHash(checks);

    const report: ComplianceReport = {
      actionId: action.id,
      timestamp: Date.now(),
      checks,
      overallStatus,
      violations,
      proofHash,
    };

    return report;
  }

  // Get laws relevant to the action
  private getRelevantLaws(action: Action): Law[] {
    const allLaws = this.lawDb.getAllLaws();
    const relevantLaws: Law[] = [];

    for (const law of allLaws) {
      // Example: If action involves health data, check HIPAA
      if (action.dataScope.some(scope => scope.includes('US_health')) && law.id === 'HIPAA_164.312') {
        relevantLaws.push(law);
      }
      // Example: If action involves EU data, check GDPR
      if (action.dataScope.some(scope => scope.includes('EU')) && law.id.startsWith('GDPR')) {
        relevantLaws.push(law);
      }
      // Example: If action involves California data, check CCPA
      if (action.dataScope.some(scope => scope.includes('CA')) && law.id.startsWith('CCPA')) {
        relevantLaws.push(law);
      }
      // Default: Check NIST for all actions (Zero Trust)
      if (law.id === 'NIST_SP800_207') {
        relevantLaws.push(law);
      }
    }

    return relevantLaws;
  }

  // Check an action against a specific law
  private async checkAgainstLaw(action: Action, law: Law): Promise<ComplianceCheck> {
    const violations: string[] = [];
    let isCompliant = true;

    // Example checks (expand with real logic)
    if (law.id === 'GDPR_Art5') {
      if (!action.metadata?.legalBasis) {
        violations.push(`Missing legal basis for processing (GDPR Art. 5(1)(a))`);
        isCompliant = false;
      }
    }

    if (law.id === 'HIPAA_164.312') {
      if (action.outcome === 'ALLOW' && !action.metadata?.justification) {
        violations.push(`Missing justification for PHI access (HIPAA §164.312)`);
        isCompliant = false;
      }
    }

    if (law.id === 'CCPA_1798.100') {
      if (!action.metadata?.disclosure) {
        violations.push(`Missing disclosure of data collection (CCPA §1798.100)`);
        isCompliant = false;
      }
    }

    // Generate proof
    const actionHash = createHash('sha256').update(JSON.stringify(action)).digest('hex');
    const combinedHash = createHash('sha256')
      .update(law.contentHash + actionHash + Date.now().toString())
      .digest('hex');

    return {
      actionId: action.id,
      lawId: law.id,
      isCompliant,
      violations,
      timestamp: Date.now(),
      proof: {
        contentHash: law.contentHash,
        actionHash,
        combinedHash,
      },
    };
  }

  // Generate a proof hash for the entire report
  private generateProofHash(checks: ComplianceCheck[]): string {
    const checkStrings = checks.map(check => JSON.stringify(check));
    const combined = checkStrings.join('') + Date.now().toString();
    return createHash('sha256').update(combined).digest('hex');
  }

  // Process all actions in the queue
  async processQueue(): Promise<void> {
    while (this.actionQueue.length > 0) {
      const action = this.actionQueue.shift()!;
      const report = await this.checkActionAgainstLaws(action);
      this.complianceReports.set(action.id, report);
      console.log(`[${new Date().toISOString()}] Processed action ${action.id}. Status: ${report.overallStatus}`);
    }
  }

  // Start real-time processing
  startRealTimeProcessing(intervalMs: number = 1000): void {
    setInterval(async () => {
      await this.processQueue();
    }, intervalMs);
  }

  // Get compliance report for an action
  getComplianceReport(actionId: string): ComplianceReport | undefined {
    return this.complianceReports.get(actionId);
  }

  // Get all compliance reports
  getAllComplianceReports(): ComplianceReport[] {
    return Array.from(this.complianceReports.values());
  }
}

