        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') registerOrganization();
        });
    });

    console.log('⟡ Ironclad Compliance Validator loaded.');
    console.log(`📋 Registry: ${registry.length} organizations.`);
    console.log(`⚖️ Laws: ${Object.keys(LAW_DB).length} loaded.`);
    console.log(`📜 Cases: ${CASE_DB.length} loaded.`);
    console.log('🔐 Cryptographic proof enabled.');
    console.log('⚡ GODSPEED.');
</script>

