                { id: '§164.314', text: 'Security standards — organizational requirements', link: 'https://www.law.cornell.edu/cfr/text/45/164.314' },
                { id: '§164.502', text: 'Uses and disclosures of protected health information', link: 'https://www.law.cornell.edu/cfr/text/45/164.502' }
            ]
        },
        'nist': {
            name: 'NIST SP 800-207 (Zero Trust Architecture)',
            jurisdiction: 'USA (Federal)',
            url: 'https://csrc.nist.gov/publications/detail/sp/800-207/final',
            articles: [
                { id: '§3.1', text: 'Zero Trust principles', link: 'https://csrc.nist.gov/pubs/sp/800/207/final' },
                { id: '§4.3', text: 'Policy enforcement', link: 'https://csrc.nist.gov/pubs/sp/800/207/final' }
            ]
        },
        'sox': {
            name: 'SOX (Sarbanes-Oxley Act)',
            jurisdiction: 'USA',
            url: 'https://www.sec.gov/spotlight/sarbanes-oxley',
            articles: [
                { id: 'Sec. 302', text: 'Corporate responsibility for financial reports', link: 'https://www.sec.gov/about/laws/soa2002.pdf' },
                { id: 'Sec. 404', text: 'Internal control assessments', link: 'https://www.sec.gov/about/laws/soa2002.pdf' }
            ]
        }
    };

    // =============================================================
    // 2. CASE LAW DATABASE
    // =============================================================
    const CASE_DB = [
        { name: 'CJEU: Schrems II', ref: 'Case C-311/18', jurisdiction: 'EU', link: 'https://curia.europa.eu/juris/liste.jsf?num=C-311/18', summary: 'Data transfers to third countries invalid if inadequate protection' },
        { name: 'HHS OCR: Cyberattack Settlement', ref: 'OCR-2022-001', jurisdiction: 'USA Healthcare', link: 'https://www.hhs.gov/hipaa/for-professionals/compliance-enforcement/examples/index.html', summary: 'Failure to implement security standards' },
        { name: 'CCPA: Enforcement Action', ref: 'OAG-2023-01', jurisdiction: 'California', link: 'https://oag.ca.gov/privacy/ccpa/enforcement', summary: 'Non-compliance with deletion requests' }
    ];

    // =============================================================
    // 3. COMPLIANCE ENGINE
    // =============================================================
    function runComplianceCheck() {
        const input = document.getElementById('complianceInput').value.trim();
        const jurisdiction = document.getElementById('jurisdictionSelect').value;

        if (!input) {
            showToast('Error', 'Please describe your process or data handling activity.');
            return;
        }

        // Show loading state
        const container = document.getElementById('resultContainer');
        container.innerHTML = `<div style="text-align:center; padding:2rem;"><div class="spinner"></div><p style="margin-top:1rem; color:#8899bb;">Scanning against ${Object.keys(LAW_DB).length} laws...</p></div>`;
        document.getElementById('checkResults').classList.remove('hidden');

        // Simulate async check (in production, this would call real APIs)
        setTimeout(() => {
            const results = performComplianceScan(input, jurisdiction);
            renderResults(results, input);
        }, 1200);
    }

    function performComplianceScan(input, jurisdiction) {
        const results = [];
        const inputLower = input.toLowerCase();

        // Check each law
        for (const [key, law] of Object.entries(LAW_DB)) {
            if (jurisdiction !== 'global' && !law.jurisdiction.toLowerCase().includes(jurisdiction.toLowerCase()) && jurisdiction !== '') {
                continue;
            }

            const violations = [];
            let isCompliant = true;

            // Keyword-based compliance checking (in production, use NLP/rule engine)
            // GDPR checks
            if (key === 'gdpr') {
                if (inputLower.includes('store') && inputLower.includes('years') && !inputLower.includes('delete')) {
                    violations.push({ article: 'Art. 5(1)(e)', text: 'Storage limitation — data should not be kept longer than necessary', link: 'https://gdpr-info.eu/art-5-gdpr/' });
                    isCompliant = false;
                }
                if (inputLower.includes('marketing') && !inputLower.includes('consent')) {
                    violations.push({ article: 'Art. 6(1)(a)', text: 'Lawfulness — consent required for marketing', link: 'https://gdpr-info.eu/art-6-gdpr/' });
                    isCompliant = false;
                }
                if (inputLower.includes('encrypt') || inputLower.includes('secure')) {
                    // compliant
                }
                if (inputLower.includes('breach')) {
                    violations.push({ article: 'Art. 33', text: 'Breach notification — must notify within 72 hours', link: 'https://gdpr-info.eu/art-33-gdpr/' });
                    isCompliant = false;
                }
            }

            // CCPA checks
            if (key === 'ccpa') {
                if (inputLower.includes('sell') && !inputLower.includes('opt-out')) {
                    violations.push({ article: '§1798.120', text: 'Right to opt-out of sale of personal information', link: 'https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.120' });
                    isCompliant = false;
                }
                if (inputLower.includes('delete') && !inputLower.includes('request')) {
                    violations.push({ article: '§1798.105', text: 'Right to delete — must provide a verifiable deletion request mechanism', link: 'https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.105' });
                    isCompliant = false;
                }
            }

            // HIPAA checks
            if (key === 'hipaa') {
                if (inputLower.includes('phi') || inputLower.includes('health') || inputLower.includes('patient')) {
                    if (!inputLower.includes('encrypt')) {
                        violations.push({ article: '§164.312(c)(1)', text: 'Encryption required for PHI at rest and in transit', link: 'https://www.law.cornell.edu/cfr/text/45/164.312' });
                        isCompliant = false;
                    }
                    if (inputLower.includes('cloud') && !inputLower.includes('baa') && !inputLower.includes('business associate')) {
                        violations.push({ article: '§164.314(a)', text: 'Business Associate Agreement required for cloud storage of PHI', link: 'https://www.law.cornell.edu/cfr/text/45/164.314' });
                        isCompliant = false;
                    }
                }
            }

            // NIST Zero Trust checks
            if (key === 'nist') {
                if (inputLower.includes('access') && !inputLower.includes('verify')) {
                    violations.push({ article: '§3.1', text: 'Zero Trust requires continuous verification of access', link: 'https://csrc.nist.gov/pubs/sp/800/207/final' });
                    isCompliant = false;
                }
                if (inputLower.includes('permanent') && inputLower.includes('access')) {
                    violations.push({ article: '§4.3', text: 'No implicit trust — permanent access violates Zero Trust principles', link: 'https://csrc.nist.gov/pubs/sp/800/207/final' });
                    isCompliant = false;
                }
            }

            // SOX checks
            if (key === 'sox') {
                if (inputLower.includes('financial') && !inputLower.includes('audit')) {
                    violations.push({ article: 'Sec. 404', text: 'Internal control audits required for financial reporting', link: 'https://www.sec.gov/about/laws/soa2002.pdf' });
                    isCompliant = false;
                }
            }

            // Determine overall status
            let status = 'COMPLIANT';
            if (violations.length > 0) {
                status = 'NON-COMPLIANT';
            } else if (isCompliant === false) {
                status = 'UNKNOWN';
            }

            results.push({
                law: law.name,
                jurisdiction: law.jurisdiction,
                url: law.url,
                status: status,
                violations: violations,
                checkedArticles: law.articles || []
            });
        }

        // Add case law references
        const caseReferences = [];
        for (const caseItem of CASE_DB) {
            if (jurisdiction !== 'global' && !caseItem.jurisdiction.toLowerCase().includes(jurisdiction.toLowerCase()) && jurisdiction !== '') {
                continue;
            }
            const inputLower = input.toLowerCase();
            if (inputLower.includes('transfer') && caseItem.name.includes('Schrems')) {
                caseReferences.push(caseItem);
            }
            if (inputLower.includes('health') && caseItem.name.includes('OCR')) {
                caseReferences.push(caseItem);
            }
            if (inputLower.includes('delete') && caseItem.name.includes('CCPA')) {
                caseReferences.push(caseItem);
            }
        }

        return { lawResults: results, caseReferences: caseReferences };
    }

    function renderResults(data, input) {
        const container = document.getElementById('resultContainer');
        const proofBox = document.getElementById('proofBox');

        let html = '';

        // Law results
        for (const result of data.lawResults) {
            const statusClass = result.status === 'COMPLIANT' ? 'compliant' : result.status === 'NON-COMPLIANT' ? 'noncompliant' : 'unknown';
            const statusIcon = result.status === 'COMPLIANT' ? '✅' : result.status === 'NON-COMPLIANT' ? '❌' : '⚠️';

            html += `
                <div class="result-card">
                    <div class="header">
                        <div>
                            <strong style="color:#f0c040;">${result.law}</strong>
                            <span class="tag">${result.jurisdiction}</span>
                        </div>
                        <span class="status-badge ${statusClass}">${statusIcon} ${result.status}</span>
                    </div>
                    <div style="font-size:0.85rem; margin:0.5rem 0;">
                        <a href="${result.url}" target="_blank" class="law-link"><i class="fas fa-external-link-alt"></i> View Law</a>
                    </div>
            `;

            if (result.violations.length > 0) {
                html += `<div style="margin:0.5rem 0; padding:0.5rem; background:rgba(255,82,82,0.05); border-radius:8px; border-left:3px solid #ff5252;">`;
                html += `<strong style="color:#ff5252;">⚠️ Potential Violations:</strong><ul style="margin:0.3rem 0 0 1rem; font-size:0.85rem;">`;
                for (const v of result.violations) {
                    html += `<li><strong>${v.article}</strong>: ${v.text} <a href="${v.link}" target="_blank" class="law-link" style="font-size:0.75rem;">↗</a></li>`;
                }
                html += `</ul></div>`;
            } else {
                html += `<div style="margin:0.5rem 0; padding:0.5rem; background:rgba(0,230,118,0.05); border-radius:8px; border-left:3px solid #00e676; font-size:0.85rem; color:#00e676;">✓ No violations detected for this law.</div>`;
            }

            // Show checked articles
            if (result.checkedArticles.length > 0) {
                html += `<details style="font-size:0.8rem; color:#8899bb; margin-top:0.3rem;">
                    <summary style="cursor:pointer;">Checked ${result.checkedArticles.length} articles</summary>
                    <ul style="margin:0.3rem 0 0 1rem;">
                `;
                for (const art of result.checkedArticles) {
                    html += `<li><a href="${art.link}" target="_blank" class="law-link">${art.id}</a>: ${art.text}</li>`;
                }
                html += `</ul></details>`;
            }

            html += `</div>`;
        }

        // Case law references
        if (data.caseReferences.length > 0) {
            html += `<div class="result-card" style="border-left-color:var(--warning);">
                <div class="header">
                    <strong style="color:var(--warning);">📜 Relevant Case Law</strong>
                    <span class="tag">Precedent</span>
                </div>
                <ul style="margin:0.3rem 0 0 1rem; font-size:0.85rem;">
            `;
            for (const c of data.caseReferences) {
                html += `<li><strong>${c.name}</strong> (${c.ref}) — ${c.summary} <a href="${c.link}" target="_blank" class="law-link">↗</a></li>`;
            }
            html += `</ul></div>`;
        }

        container.innerHTML = html;

        // Generate cryptographic proof
        const proofInput = `${input}|${JSON.stringify(data)}|${Date.now()}`;
        const proofHash = sha256(proofInput);
        const proofShort = proofHash.substring(0, 16);
        const timestamp = new Date().toISOString();

        proofBox.innerHTML = `
            <strong>🔐 Cryptographic Proof of Check</strong><br/>
            Check ID: <span style="color:var(--gold);">${proofShort}</span><br/>
            Timestamp: ${timestamp}<br/>
            Hash: ${proofHash}<br/>
            <span style="color:#556; font-size:0.7rem;">This proof can be independently verified.</span>
        `;

        // Store in local history
        storeCheckHistory(input, proofShort, timestamp);

        showToast('Success', `Compliance check complete. ${data.lawResults.filter(r => r.status === 'COMPLIANT').length} compliant, ${data.lawResults.filter(r => r.status === 'NON-COMPLIANT').length} non-compliant.`);
    }

    // =============================================================
    // 4. REGISTRY SYSTEM
    // =============================================================
    let registry = JSON.parse(localStorage.getItem('complianceRegistry')) || [];

    function registerOrganization() {
        const name = document.getElementById('orgName').value.trim();
        const industry = document.getElementById('orgIndustry').value.trim();
        const jurisdiction = document.getElementById('orgJurisdiction').value.trim();

        if (!name || !industry || !jurisdiction) {
            showToast('Error', 'Please fill in all organization details.');
            return;
        }

        // Check if already registered
        if (registry.some(org => org.name.toLowerCase() === name.toLowerCase())) {
            showToast('Error', 'This organization is already registered.');
            return;
        }

        // Generate unique ID
        const id = 'CRC-' + (registry.length + 1).toString(16).padStart(8, '0').toUpperCase();
        const proof = sha256(`${name}|${industry}|${jurisdiction}|${Date.now()}`).substring(0, 16);
        const timestamp = new Date().toISOString();

        const entry = {
            id: id,
            name: name,
            industry: industry,
            jurisdiction: jurisdiction,
            status: 'COMPLIANT',
            registered: timestamp,
            proof: proof,
            lastCheck: timestamp
        };

        registry.push(entry);
        localStorage.setItem('complianceRegistry', JSON.stringify(registry));

        // Show badge
        document.getElementById('badgeOrgName').textContent = name;
        document.getElementById('badgeId').textContent = `ID: ${id}`;
        document.getElementById('badgeJurisdiction').textContent = `Jurisdiction: ${jurisdiction}`;
        document.getElementById('badgeStatus').textContent = '✓ COMPLIANT';
        document.getElementById('badgeProof').textContent = `proof: 0x${proof}`;
        document.getElementById('badgeDate').textContent = new Date(timestamp).toLocaleDateString();
        document.getElementById('registrationResult').classList.remove('hidden');

        showToast('Success', `Organization "${name}" registered with ID ${id}.`);

        // Clear form
        document.getElementById('orgName').value = '';
        document.getElementById('orgIndustry').value = '';
        document.getElementById('orgJurisdiction').value = '';
    }

