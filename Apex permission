export class ComplianceAuditor {
  private auditTrail: PermissionLog[] = [];
  private immutableLedger: Map<string, string> = new Map(); // hash → previousHash
  private lastBlockHash: string = createHash('sha256').update('GENESIS').digest('hex');
  private anomalyThreshold: number = 0.65; // Shannon entropy threshold

  // --- 1. Enhanced Audit with Cryptographic Chain ---
  auditPermissionLog(log: PermissionLog): ComplianceReport {
    const anomalies: string[] = [];
    this._validateMandatoryFields(log, anomalies);
    this._checkDataScopeConsistency(log, anomalies);
    this._anomalyDetection(log, anomalies);
    this._appendToImmutableChain(log);

    const score = this._calculateComplianceScore(anomalies);
    const isCompliant = score >= 80;

    return {
      status: isCompliant ? 'VALIDATED' : score >= 60 ? 'FLAGGED' : 'FAILED',
      score,
      anomalies,
      chainHash: this.lastBlockHash,
      complianceRefs: this._getApplicableRefs(log),
      blockHeight: this.auditTrail.length,
    };
  }

  // --- 2. Mandatory Field Validation (GDPR Art. 5, NIST 800-207) ---
  private _validateMandatoryFields(log: PermissionLog, anomalies: string[]): void {
    if (!log.timestamp) anomalies.push('Missing timestamp (GDPR Art. 5)');
    if (!log.userIntent) anomalies.push('Missing user_intent (NIST 800-207 §3.1)');
    if (!log.dataScope?.length) anomalies.push('Data scope undefined (CCPA §1798.100)');
    if (!log.resource) anomalies.push('Resource missing (HIPAA §164.312)');
    if (log.outcome === undefined) anomalies.push('Outcome missing (ISO 27001 A.12.4.1)');
  }

  // --- 3. Data Scope Consistency (Least Privilege) ---
  private _checkDataScopeConsistency(log: PermissionLog, anomalies: string[]): void {
    const sensitivePatterns = ['PII', 'PHI', 'PCI', 'GDPR'];
    const hasSensitive = log.dataScope.some(d => sensitivePatterns.some(p => d.includes(p)));
    if (hasSensitive && log.outcome === 'ALLOW' && !log.metadata?.justification) {
      anomalies.push('Sensitive data access without justification (NIST 800-207 §4.3)');
    }
  }

  // --- 4. Anomaly Detection via Shannon Entropy ---
  private _anomalyDetection(log: PermissionLog, anomalies: string[]): void {
    // Compute entropy of the log's concatenated fields
    const combined = `${log.userIntent}${log.resource}${log.dataScope.join('')}${log.timestamp}`;
    const entropy = this._shannonEntropy(combined);

    if (entropy > this.anomalyThreshold) {
      anomalies.push(`High entropy (${entropy.toFixed(3)}) – possible obfuscation (Shannon, 1948)`);
    }

    // Check for burst of recent DENY events (statistical anomaly)
    const recentDenies = this.auditTrail.slice(-10).filter(l => l.outcome === 'DENY').length;
    if (recentDenies >= 7) {
      anomalies.push(`Burst of DENY events (${recentDenies}/10) – potential privilege escalation (ML‑based pattern)`);
    }
  }

  // --- 5. Immutable Chain (Merkle‑like) ---
  private _appendToImmutableChain(log: PermissionLog): void {
    const entry = JSON.stringify(log);
    const hash = createHash('sha256').update(entry + this.lastBlockHash).digest('hex');
    this.immutableLedger.set(hash, this.lastBlockHash);
    this.lastBlockHash = hash;
    this.auditTrail.push(log);
  }

  // --- 6. Compliance Score Calculation ---
  private _calculateComplianceScore(anomalies: string[]): number {
    const baseScore = 100;
    const deduction = Math.min(anomalies.length * 10, 70);
    return Math.max(baseScore - deduction, 0);
  }

  // --- 7. Applicable Regulatory References ---
  private _getApplicableRefs(log: PermissionLog): string[] {
    const refs: string[] = ['NIST SP 800-207 (Zero Trust)'];
    if (log.dataScope.some(d => d.includes('EU'))) refs.push('GDPR Art. 5, Art. 32');
    if (log.dataScope.some(d => d.includes('CA'))) refs.push('CCPA §1798.100');
    if (log.dataScope.some(d => d.includes('US_health'))) refs.push('HIPAA §164.312');
    if (log.metadata?.iso27001) refs.push('ISO/IEC 27001:2022 A.12.4');
    return refs;
  }

  // --- 8. Shannon Entropy (1948, Bell Labs) ---
  private _shannonEntropy(str: string): number {
    const len = str.length;
    const freq = new Map<string, number>();
    for (const char of str) freq.set(char, (freq.get(char) || 0) + 1);
    let entropy = 0;
    for (const [, count] of freq) {
      const p = count / len;
      entropy -= p * Math.log2(p);
    }
    return entropy; // Max ~8 bits for ASCII; threshold >6.5 suspicious
  }

  // --- 9. Blockchain Anchoring (optional, for immutability) ---
  async anchorToBlockchain(providerUrl: string, contractAddress: string): Promise<string> {
    const provider = new ethers.JsonRpcProvider(providerUrl);
    const wallet = new ethers.Wallet(process.env.BLOCKCHAIN_PRIVATE_KEY!, provider);
    const contract = new ethers.Contract(contractAddress, ['function storeHash(string)'], wallet);
    const tx = await contract.storeHash(this.lastBlockHash);
    await tx.wait();
    return tx.hash;
  }

  // --- 10. Generate Zero‑Knowledge Proof of Compliance (draft) ---
  generateZKProof(logId: string): { proof: string; publicSignals: string[] } {
    // Placeholder for zk-SNARK/STARK integration
    // In production, use circom or snarkjs to prove compliance without revealing log content
    return {
      proof: `zk_proof_${randomBytes(16).toString('hex')}`,
      publicSignals: ['timestamp_gt_epoch', 'outcome_allow'],
    };
  }
